---
const links = [
  { href: '#experience', label: 'Experience' },
  { href: '#education', label: 'Education' },
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
  { href: '#beyond', label: 'Beyond Work' },
  { href: '#contact', label: 'Contact' },
];
const themes = [
  { id: 'abyss', label: 'Deep Navy', swatch: '#040a18', ring: '#5eead4' },
  { id: 'noir', label: 'Black', swatch: '#050505', ring: '#e4e4e7' },
  { id: 'midnight', label: 'Midnight', swatch: '#07070f', ring: '#a78bfa' },
];
---
<header class="fixed inset-x-0 top-0 z-50 px-4">
  <nav
    class="mx-auto mt-3 flex max-w-6xl items-center justify-between gap-4 rounded-2xl border px-4 py-3 backdrop-blur-xl sm:px-6"
    style="border-color: var(--line); background: color-mix(in srgb, var(--bg) 70%, transparent);"
  >
    <a href="#top" class="font-[family-name:var(--font-display)] text-lg font-semibold tracking-tight">
      VZ<span style="color: var(--accent)">.</span>
    </a>

    <ul class="hidden items-center gap-7 text-sm md:flex" style="color: var(--muted)">
      {links.map((l) => <li><a href={l.href} data-nav-link class="nav-link transition hover:text-[var(--text)]">{l.label}</a></li>)}
    </ul>

    <div class="flex items-center gap-3">
      <button type="button" data-tldr-open class="tldr-btn rounded-full border px-3 py-1.5 text-xs font-medium whitespace-nowrap">
        <span class="hidden sm:inline">30-sec version</span><span class="sm:hidden">TL;DR</span>
      </button>
      <div class="flex items-center gap-1.5" role="group" aria-label="Colour theme">
        {themes.map((t) => (
          <button
            type="button"
            data-set-theme={t.id}
            title={t.label}
            aria-label={`Theme: ${t.label}`}
            class="theme-btn size-5 rounded-full border-2 transition hover:scale-110"
            style={`background:${t.swatch}; border-color:${t.ring}`}
          />
        ))}
      </div>
      <button id="menu-btn" class="md:hidden" aria-label="Open menu" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </nav>

  <ul
    id="mobile-menu"
    class="mx-4 mt-2 hidden flex-col gap-1 rounded-2xl border p-3 text-sm backdrop-blur-xl md:hidden"
    style="border-color: var(--line); background: color-mix(in srgb, var(--bg) 85%, transparent)"
  >
    {links.map((l) => <li><a href={l.href} data-nav-link class="nav-link block rounded-lg px-3 py-2 hover:bg-white/5">{l.label}</a></li>)}
  </ul>
</header>

<script>
  const root = document.documentElement;
  const mark = () =>
    document.querySelectorAll<HTMLButtonElement>('.theme-btn').forEach((b) => {
      b.style.boxShadow = b.dataset.setTheme === root.dataset.theme ? '0 0 0 3px var(--glow)' : 'none';
    });
  document.querySelectorAll<HTMLButtonElement>('[data-set-theme]').forEach((b) =>
    b.addEventListener('click', () => {
      root.dataset.theme = b.dataset.setTheme;
      try { localStorage.setItem('theme', b.dataset.setTheme!); } catch {}
      mark();
    }),
  );
  mark();

  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  btn.addEventListener('click', () => {
    const open = menu.classList.toggle('hidden') === false;
    menu.classList.toggle('flex', open);
    btn.setAttribute('aria-expanded', String(open));
  });
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
    menu.classList.add('hidden'); menu.classList.remove('flex');
  }));

  // Scroll spy: highlight the nav link of the section currently in view.
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const setActive = (id: string | null) =>
    navLinks.forEach((a) => {
      const on = id !== null && a.getAttribute('href') === `#${id}`;
      a.classList.toggle('is-active', on);
      if (on) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    });
  const sections = [...new Set(navLinks.map((a) => a.getAttribute('href')!.slice(1)))]
    .map((id) => document.getElementById(id))
    .filter((s): s is HTMLElement => !!s);
  const spy = () => {
    const line = window.innerHeight * 0.35;
    let current: string | null = null;
    for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s.id;
    // at the very bottom, the last section wins
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) current = sections.at(-1)?.id ?? current;
    setActive(current);
  };
  addEventListener('scroll', spy, { passive: true });
  addEventListener('resize', spy);
  spy();
</script>

<style>
  .tldr-btn {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    color: var(--accent);
    transition: background 0.25s ease, box-shadow 0.25s ease;
  }
  .tldr-btn:hover, .tldr-btn:focus-visible {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    box-shadow: 0 0 20px var(--glow);
    outline: none;
  }
  .nav-link.is-active {
    color: var(--accent);
  }
</style>
