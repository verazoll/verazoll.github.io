---
// Hobbies arranged in a slowly turning circle around a centre that says "what makes me".
// Hover (or tap / keyboard focus) a circle: it grows, the ring pauses, and the centre shows its story.
import { beyond } from '../data/profile';

const n = beyond.length;
const R = 39; // ring radius in % of the container
const items = beyond.map((b, i) => {
  const a = ((i / n) * 360 - 90) * (Math.PI / 180);
  return {
    ...b,
    left: 50 + R * Math.cos(a),
    top: 50 + R * Math.sin(a),
    pos: 'pos' in b && b.pos ? b.pos : 'center',
    badge: 'stat' in b && b.stat ? b.stat : '',
  };
});
---
<div class="orbit reveal relative mx-auto aspect-square w-full max-w-[40rem]" data-orbit>
  <!-- guide rings -->
  <div aria-hidden="true" class="absolute inset-[11%] rounded-full border" style="border-color: var(--line)"></div>
  <div aria-hidden="true" class="absolute inset-[30%] rounded-full" style="background: radial-gradient(circle, var(--glow), transparent 70%)"></div>

  <!-- centre -->
  <div class="absolute inset-[31%] grid place-items-center rounded-full border text-center" style="border-color: var(--line); background: color-mix(in srgb, var(--bg) 70%, transparent)">
    <div class="px-[8%]" aria-live="polite">
      <p class="eyebrow text-[0.6rem] sm:text-[0.7rem]" data-orbit-eyebrow>What makes me</p>
      <p class="mt-1 font-[family-name:var(--font-display)] text-base font-semibold sm:mt-2 sm:text-2xl" data-orbit-title>Beyond work</p>
      <p class="mt-1 text-[0.65rem] leading-snug sm:mt-2 sm:text-sm" style="color: var(--muted)" data-orbit-text>Hover a circle</p>
    </div>
  </div>

  <!-- ring -->
  <ul class="orbit-ring absolute inset-0">
    {items.map((it) => (
      <li class="absolute size-[23%] -translate-x-1/2 -translate-y-1/2" style={`left:${it.left}%; top:${it.top}%`}>
        <div class="orbit-counter size-full">
          <button
            type="button"
            class="orbit-tile group relative block size-full rounded-full p-[3px]"
            data-title={it.title}
            data-text={it.text}
            aria-label={`${it.title}: ${it.text}`}
          >
            <img src={it.image} alt="" loading="lazy" class="size-full rounded-full object-cover" style={`object-position:${it.pos}`} />
            <span class="orbit-label pointer-events-none absolute -bottom-6 left-1/2 -translate-x-1/2 whitespace-nowrap text-[0.65rem] font-medium sm:text-xs" style="color: var(--muted)">{it.title}</span>
            {it.badge && (
              <span class="absolute -top-1 -right-1 rounded-full px-2 py-0.5 font-[family-name:var(--font-display)] text-[0.6rem] font-semibold sm:text-xs" style="background: var(--accent); color: var(--bg)">{it.badge}</span>
            )}
          </button>
        </div>
      </li>
    ))}
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-orbit]').forEach((orbit) => {
    const eyebrow = orbit.querySelector<HTMLElement>('[data-orbit-eyebrow]')!;
    const title = orbit.querySelector<HTMLElement>('[data-orbit-title]')!;
    const text = orbit.querySelector<HTMLElement>('[data-orbit-text]')!;
    const initial = [eyebrow.textContent, title.textContent, text.textContent];
    const show = (t: HTMLElement) => {
      orbit.classList.add('is-active');
      eyebrow.textContent = 'Beyond work';
      title.textContent = t.dataset.title ?? '';
      text.textContent = t.dataset.text ?? '';
    };
    const reset = () => {
      orbit.classList.remove('is-active');
      [eyebrow.textContent, title.textContent, text.textContent] = initial;
    };
    orbit.querySelectorAll<HTMLElement>('.orbit-tile').forEach((t) => {
      t.addEventListener('pointerenter', () => show(t));
      t.addEventListener('focus', () => show(t));
      t.addEventListener('click', () => show(t));
    });
    orbit.addEventListener('pointerleave', reset);
    orbit.addEventListener('focusout', (e) => {
      if (!orbit.contains(e.relatedTarget as Node)) reset();
    });
  });
</script>

<style>
  /* slow carousel turn; tiles counter-rotate so photos stay upright */
  .orbit-ring {
    animation: orbit-spin 120s linear infinite;
  }
  .orbit-counter {
    animation: orbit-spin 120s linear infinite reverse;
  }
  .orbit:hover .orbit-ring,
  .orbit:hover .orbit-counter,
  .orbit:focus-within .orbit-ring,
  .orbit:focus-within .orbit-counter {
    animation-play-state: paused;
  }
  @keyframes orbit-spin {
    to { transform: rotate(360deg); }
  }

  .orbit-tile {
    background: conic-gradient(from 180deg, var(--accent), var(--accent-2), var(--accent));
    transition: transform 0.5s cubic-bezier(0.22, 1.3, 0.36, 1), filter 0.4s ease, opacity 0.4s ease, box-shadow 0.5s ease;
    cursor: pointer;
  }
  .orbit-tile img {
    border: 2px solid var(--bg);
  }
  .orbit-tile:hover,
  .orbit-tile:focus-visible {
    transform: scale(1.35);
    z-index: 2;
    box-shadow: 0 0 40px var(--glow);
    outline: none;
  }
  .orbit-tile:hover .orbit-label,
  .orbit-tile:focus-visible .orbit-label {
    opacity: 0;
  }
  .orbit.is-active .orbit-tile:not(:hover):not(:focus-visible) {
    opacity: 0.45;
    filter: saturate(0.6);
    transform: scale(0.92);
  }
  .orbit-label {
    transition: opacity 0.3s ease;
  }
  li:has(.orbit-tile:hover),
  li:has(.orbit-tile:focus-visible) {
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit-ring, .orbit-counter { animation: none; }
    .orbit-tile { transition: none; }
  }
</style>
