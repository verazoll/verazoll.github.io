---
// Subtle world-map illustration (static SVG rendered at build time).
// Used as a faint backdrop behind the hero stats. When it first scrolls into view,
// the regions light up one after another and the hub dots appear (once, ~1.5 s).
import { geoEqualEarth, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import world from 'world-atlas/countries-110m.json';
import { markets } from '../data/profile';

interface Props { class?: string }
const { class: className = '' } = Astro.props;

const W = 1000;
const H = 470;
const all = (feature(world as any, (world as any).objects.countries) as any).features.filter(
  (f: any) => f.properties.name !== 'Antarctica',
);
const projection = geoEqualEarth().fitExtent([[4, 4], [W - 4, H - 4]], { type: 'FeatureCollection', features: all } as any);
const path = geoPath(projection);
path.digits?.(1); // keep the SVG small

// country -> index of its region (order of markets.regions = order of lighting up)
const regionOf = new Map<string, number>();
markets.regions.forEach((r, i) => r.countries.forEach((c) => regionOf.set(c, i)));
const STEP = 0.18; // seconds between regions

const countries = all.map((f: any) => {
  const name = f.properties.name as string;
  const region = regionOf.get(name);
  const isHome = region !== undefined && markets.regions[region].name === 'Home base';
  return { d: path(f) ?? '', state: region === undefined ? 'idle' : isHome ? 'home' : 'active', delay: (region ?? 0) * STEP };
});
const hubsDelay = markets.regions.length * STEP;
const hubs = markets.hubs.map((h, i) => {
  const [x, y] = projection([h.lon, h.lat])!;
  return { x, y, remote: 'remote' in h && !!h.remote, delay: hubsDelay + i * 0.08 };
});
---
<svg viewBox={`0 0 ${W} ${H}`} class={`map-backdrop pointer-events-none select-none ${className}`} aria-hidden="true" data-map>
  {countries.map((c) => (
    <path
      d={c.d}
      class={`m-${c.state}`}
      fill={c.state === 'home' ? 'var(--accent-2)' : c.state === 'active' ? 'var(--accent)' : 'var(--text)'}
      style={c.state === 'idle' ? undefined : `transition-delay:${c.delay}s`}
    />
  ))}
  {hubs.map((h) =>
    h.remote ? (
      <circle class="m-hub" cx={h.x} cy={h.y} r="7" fill="none" stroke="var(--accent)" stroke-opacity="0.8" stroke-width="2" style={`transition-delay:${h.delay}s`} />
    ) : (
      <circle class="m-hub" cx={h.x} cy={h.y} r="5" fill="var(--accent)" fill-opacity="0.7" style={`transition-delay:${h.delay}s`} />
    ),
  )}
</svg>

<script>
  // Light the map up once when it becomes visible (the page works without this: see .no-anim below).
  document.querySelectorAll<SVGSVGElement>('[data-map]').forEach((svg) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { svg.classList.add('lit'); return; }
    svg.classList.add('armed');
    new IntersectionObserver((entries, obs) => {
      if (entries.some((e) => e.isIntersecting)) { svg.classList.add('lit'); obs.disconnect(); }
    }, { threshold: 0.3 }).observe(svg);
  });
</script>

<style>
  .map-backdrop {
    /* fade out towards the edges so it reads as an illustration, not a chart */
    mask-image: radial-gradient(ellipse closest-side at 50% 50%, #000 35%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse closest-side at 50% 50%, #000 35%, transparent 100%);
  }
  .m-idle { fill-opacity: 0.06; }
  .m-active, .m-home { fill-opacity: 0.32; transition: fill-opacity 0.6s ease; }
  .m-hub { opacity: 1; transition: opacity 0.5s ease; }

  /* before the reveal: markets look like every other country, dots hidden */
  .armed:not(.lit) .m-active,
  .armed:not(.lit) .m-home { fill-opacity: 0.06; }
  .armed:not(.lit) .m-hub { opacity: 0; }
</style>
