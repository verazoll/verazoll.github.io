---
// Subtle world-map illustration (static SVG rendered at build time, no client JS).
// Used as a faint backdrop behind the hero stats; markets are slightly brighter.
import { geoEqualEarth, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import world from 'world-atlas/countries-110m.json';
import { markets } from '../data/profile';

interface Props { class?: string }
const { class: className = '' } = Astro.props;

const W = 1000;
const H = 470;
const all = (feature(world as any, (world as any).objects.countries) as any).features.filter(
  (f: any) => f.properties.name !== 'Antarctica',
);
const projection = geoEqualEarth().fitExtent([[4, 4], [W - 4, H - 4]], { type: 'FeatureCollection', features: all } as any);
const path = geoPath(projection);
path.digits?.(1); // keep the SVG small

const home = new Set(markets.regions.filter((r) => r.name === 'Home base').flatMap((r) => r.countries));
const active = new Set(markets.regions.flatMap((r) => r.countries));
const countries = all.map((f: any) => ({
  d: path(f) ?? '',
  state: home.has(f.properties.name) ? 'home' : active.has(f.properties.name) ? 'active' : 'idle',
}));
const hubs = markets.hubs.map((h) => {
  const [x, y] = projection([h.lon, h.lat])!;
  return { x, y };
});
---
<svg viewBox={`0 0 ${W} ${H}`} class={`map-backdrop pointer-events-none select-none ${className}`} aria-hidden="true">
  {countries.map((c) => (
    <path
      d={c.d}
      fill={c.state === 'home' ? 'var(--accent-2)' : c.state === 'active' ? 'var(--accent)' : 'var(--text)'}
      fill-opacity={c.state === 'idle' ? 0.06 : 0.32}
    />
  ))}
  {hubs.map((h) => <circle cx={h.x} cy={h.y} r="5" fill="var(--accent)" fill-opacity="0.7" />)}
</svg>

<style>
  .map-backdrop {
    /* fade out towards the edges so it reads as an illustration, not a chart */
    mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 40%, transparent 100%);
  }
</style>
