---
// Simple shell for the imprint and privacy pages.
import Layout from '../layouts/Layout.astro';
interface Props { title: string }
const { title } = Astro.props;
---
<Layout title={`${title} – Vera Zoll`} description={`${title} for verazoll.com`}>
  <main class="legal mx-auto max-w-2xl px-4 py-16 sm:px-6 sm:py-24">
    <a href="/" class="text-sm transition hover:text-[var(--text)]" style="color: var(--muted)">← Back to verazoll.com</a>
    <h1 class="mt-8 font-[family-name:var(--font-display)] text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
    <div class="mt-8"><slot /></div>
  </main>
</Layout>

<style is:global>
  .legal h2 { margin-top: 2.25rem; font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; }
  .legal p, .legal li { margin-top: 0.75rem; font-size: 0.95rem; line-height: 1.7; color: var(--muted); }
  .legal ul { list-style: disc; padding-left: 1.25rem; }
  .legal a { color: var(--accent); }
</style>
