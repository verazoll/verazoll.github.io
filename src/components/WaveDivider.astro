---
// Thin wave line between sections that draws itself while you scroll past it.
// A nod to surfing and to funnel curves. Fully drawn without JS or with reduced motion.
interface Props { flip?: boolean }
const { flip = false } = Astro.props;
const id = `wave-grad-${Math.random().toString(36).slice(2, 8)}`;
---
<div class="wave-divider mx-auto max-w-6xl px-4 sm:px-6" aria-hidden="true">
  <svg viewBox="0 0 1200 60" preserveAspectRatio="none" class="h-10 w-full sm:h-12" style={flip ? 'transform: scaleX(-1)' : undefined}>
    <defs>
      <linearGradient id={id} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0" />
        <stop offset="20%" stop-color="var(--accent)" stop-opacity="0.55" />
        <stop offset="80%" stop-color="var(--accent-2)" stop-opacity="0.55" />
        <stop offset="100%" stop-color="var(--accent-2)" stop-opacity="0" />
      </linearGradient>
    </defs>
    <path
      data-wave
      d="M0 30 C 100 30, 150 8, 250 8 S 400 52, 500 52 S 650 14, 750 14 S 900 46, 1000 46 S 1120 30, 1200 30"
      fill="none"
      stroke={`url(#${id})`}
      stroke-width="1.5"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"
    />
  </svg>
</div>

<script>
  const waves = [...document.querySelectorAll<SVGPathElement>('[data-wave]')];
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && waves.length) {
    waves.forEach((p) => {
      const len = p.getTotalLength();
      p.style.strokeDasharray = `${len}`;
      p.style.strokeDashoffset = `${len}`;
      p.dataset.len = String(len);
    });
    const update = () => {
      const vh = innerHeight;
      waves.forEach((p) => {
        const top = p.getBoundingClientRect().top;
        // 0 when the line enters at the bottom of the screen, 1 once it reaches ~40% from the top
        const k = Math.min(1, Math.max(0, (vh - top) / (vh * 0.6)));
        p.style.strokeDashoffset = String(Number(p.dataset.len) * (1 - k));
      });
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
