---
// Nova AI Club mark rebuilt as SVG (squares on a 7x7 grid, a ring around an empty centre).
// The squares pulse softly from the centre outwards; static with reduced motion.
interface Props { class?: string }
const { class: className = '' } = Astro.props;
const S = { s: 7, m: 14, b: 18 };
const quarter: [number, number, keyof typeof S][] = [
  [-1, -3, 's'], [0, -3, 'b'],
  [-2, -2, 's'], [-1, -2, 'b'], [0, -2, 'b'],
  [-3, -1, 's'], [-2, -1, 'm'], [-1, -1, 'b'],
  [-3, 0, 'm'], [-2, 0, 'b'],
];
// mirror the left/top quarter to all four sides, dedupe
const seen = new Set<string>();
const squares = quarter
  .flatMap(([x, y, k]) => [[x, y], [-x, y], [x, -y], [-x, -y]].map(([a, b]) => [a, b, k] as const))
  .filter(([x, y]) => (seen.has(`${x},${y}`) ? false : (seen.add(`${x},${y}`), true)))
  .map(([x, y, k]) => ({ x, y, size: S[k], d: Math.hypot(x, y) }));
const G = 38; // grid step
---
<svg viewBox="-150 -150 300 300" class={`ai-mark ${className}`} role="img" aria-label="Nova AI Club logo">
  {squares.map((q) => (
    <rect
      x={q.x * G - q.size / 2}
      y={q.y * G - q.size / 2}
      width={q.size}
      height={q.size}
      fill="#f2f0ea"
      style={`animation-delay:${(q.d * 0.18).toFixed(2)}s`}
    />
  ))}
</svg>

<style>
  .ai-mark rect {
    transform-box: fill-box;
    transform-origin: center;
    animation: ai-pulse 3.2s ease-in-out infinite;
  }
  @keyframes ai-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.8); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ai-mark rect { animation: none; }
  }
</style>
