---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import MarketsMap from '../components/MarketsMap.astro';
import HobbyOrbit from '../components/HobbyOrbit.astro';
import DataFlow from '../components/DataFlow.astro';
import { profile, experience, education, projects, skills, surfClub, workGallery } from '../data/profile';

import { existsSync } from 'node:fs';

// Images are picked up automatically once the files exist in public/images/.
const img = (file: string) => (existsSync(`public/images/${file}`) ? `/images/${file}` : '');
const portrait = img('portrait.jpg');
const porscheBanner = img('porsche-surf.jpg');
const headlineParts = profile.headline.split(' | ');
---
<Layout title="Vera Zoll – This is Me" description={profile.intro}>
  <Nav />

  <!-- Ambient background glow -->
  <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
    <div class="absolute -top-64 left-1/2 size-[28rem] -translate-x-1/2 rounded-full opacity-70 blur-3xl sm:size-[42rem]" style="background: var(--glow)"></div>
    <div class="absolute -bottom-72 -right-48 size-[24rem] rounded-full opacity-40 blur-3xl sm:size-[36rem]" style="background: var(--glow)"></div>
  </div>

  <main id="top" class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- HERO -->
    <section class="grid min-h-[100svh] items-center gap-12 pt-28 pb-16 md:grid-cols-[1.3fr_1fr]">
      <div class="reveal">
        <p class="eyebrow mb-5">{profile.location}</p>
        <h1 class="font-[family-name:var(--font-display)] text-5xl font-semibold leading-[1.02] tracking-tight sm:text-7xl">
          <span class="gradient-text">{profile.name}</span>
        </h1>
        <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-lg sm:text-xl" style="color: var(--text)">
          {headlineParts.map((part, i) => (
            <>
              {i > 0 && i < headlineParts.length - 1 && <span aria-hidden="true" style="color: var(--accent)">/</span>}
              <span class={i === headlineParts.length - 1 ? 'basis-full italic' : ''} style={i === headlineParts.length - 1 ? 'color: var(--muted)' : ''}>{part}</span>
            </>
          ))}
        </p>
        <p class="mt-6 max-w-xl leading-relaxed" style="color: var(--muted)">{profile.intro}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#projects" class="rounded-full px-6 py-3 text-sm font-medium transition hover:opacity-90" style="background: var(--accent); color: var(--bg)">See my projects</a>
          <a href={profile.links.linkedin} target="_blank" rel="noopener" class="rounded-full border px-6 py-3 text-sm font-medium transition hover:bg-white/5" style="border-color: var(--line)">LinkedIn ↗</a>
        </div>
        <dl class="relative isolate mt-14 grid max-w-md grid-cols-3 gap-6">
          <MarketsMap class="absolute top-1/2 left-1/2 -z-10 w-[22rem] max-w-none -translate-x-1/2 -translate-y-1/2 sm:w-[28rem]" />
          {profile.stats.map((s) => (
            <div>
              <dt class="font-[family-name:var(--font-display)] text-3xl font-semibold sm:text-4xl" style="color: var(--accent)">{s.value}</dt>
              <dd class="mt-1 text-xs leading-snug" style="color: var(--muted)">{s.label}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="reveal relative mx-auto w-full max-w-sm">
        <div class="absolute -inset-4 aspect-square rounded-full blur-2xl" style="background: var(--glow)"></div>
        {portrait ? (
          <div class="relative aspect-square w-full rounded-full p-[3px]" style="background: conic-gradient(from 200deg, var(--accent), var(--accent-2), var(--accent))">
            <img src={portrait} alt="Portrait of Vera Zoll" class="size-full rounded-full object-cover" style="object-position: center 22%; border: 3px solid var(--bg)" />
          </div>
        ) : (
          <div class="placeholder relative grid aspect-square w-full place-items-center rounded-full text-sm">Portrait</div>
        )}
        <ul class="relative mt-5 flex flex-wrap justify-center gap-2">
          {profile.traits.map((t) => <li class="tag">{t}</li>)}
        </ul>
        <p class="relative mt-3 text-center font-[family-name:var(--font-display)] text-sm italic" style="color: var(--muted)">
          {profile.motto}
        </p>
      </div>
    </section>

    <!-- EXPERIENCE -->
    <section id="experience" class="relative isolate py-12 md:py-16">
      <!-- faint Porscheplatz sculpture behind the experience timeline -->
      <img
        src="/images/work/porsche-platz.jpg"
        alt=""
        aria-hidden="true"
        loading="lazy"
        class="experience-backdrop pointer-events-none absolute -top-60 right-0 -z-10 h-[64rem] max-h-full w-auto max-w-full select-none object-cover opacity-[0.4]"
      />
      <div class="reveal mb-12">
        <p class="eyebrow">Experience</p>
        <h2 class="mt-3 font-[family-name:var(--font-display)] text-3xl font-semibold tracking-tight sm:text-5xl">Eight years at Porsche AG</h2>
        <p class="mt-4 max-w-2xl" style="color: var(--muted)">From dual student to driving regional CRM, sales and marketing for Asia Pacific and Australia – with business trips to Singapore, Australia and Thailand.</p>
      </div>

      {porscheBanner && (
        <img src={porscheBanner} alt="Porsche 911 Cabriolet with a surfboard at the beach" class="reveal mb-12 aspect-[21/9] w-full rounded-3xl object-cover" style="border: 1px solid var(--line)" />
      )}

      <ol class="exp-list relative space-y-6 border-l pl-6 sm:pl-10" style="border-color: var(--line)">
        {experience.map((e) => (
          <li class="exp-item reveal relative">
            <span class="exp-dot absolute -left-[31px] top-7 size-3 rounded-full sm:-left-[47px]" style="background: var(--accent)"></span>
            <article class="card exp-card p-6 sm:p-8">
              <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline">
                <h3 class="font-[family-name:var(--font-display)] text-xl font-semibold">{e.role}</h3>
                <span class="text-sm tabular-nums" style="color: var(--muted)">{e.period}</span>
              </div>
              <p class="mt-1 text-sm" style="color: var(--accent)">{e.org}</p>
              <ul class="mt-4 space-y-2 text-[15px] leading-relaxed" style="color: var(--muted)">
                {e.points.map((p) => <li>– {p}</li>)}
              </ul>
              {'stations' in e && e.stations && (
                <ol class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                  {e.stations.map((s, i) => (
                    <li class="rounded-xl border p-4" style="border-color: var(--line); background: color-mix(in srgb, var(--bg) 40%, transparent)">
                      <p class="text-xs tabular-nums" style="color: var(--accent)">{String(i + 1).padStart(2, '0')}</p>
                      <p class="mt-1 font-[family-name:var(--font-display)] font-semibold">{s.name}</p>
                      {s.detail && <p class="mt-1 text-sm leading-snug" style="color: var(--muted)">{s.detail}</p>}
                    </li>
                  ))}
                </ol>
              )}
              <div class="mt-5 flex flex-wrap gap-2">{e.tags.map((t) => <span class="tag">{t}</span>)}</div>
            </article>
          </li>
        ))}
      </ol>

      <!-- Work moments: small supporting photo strip -->
      <div class="reveal mt-16 mb-5">
        <p class="eyebrow text-[0.7rem]">Porsche Moments</p>
        <p class="mt-1 font-[family-name:var(--font-display)] text-base font-medium italic tracking-tight sm:text-lg">
          Driven by dreams for eight years…
        </p>
      </div>
      <div class="reveal -mx-4 flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 pb-3 sm:-mx-6 sm:px-6 [scrollbar-width:thin]">
        {workGallery.map((g) => (
          <figure class="card w-[44%] shrink-0 snap-start overflow-hidden sm:w-[30%] lg:w-[18%]">
            <img src={g.src} alt={g.caption} loading="lazy" class="aspect-square w-full object-cover" style={'pos' in g && g.pos ? `object-position: ${g.pos}` : ''} />
            <figcaption class="px-3 py-2 text-xs leading-snug" style="color: var(--muted)">{g.caption}</figcaption>
          </figure>
        ))}
      </div>
      <p class="reveal mt-4 text-right font-[family-name:var(--font-display)] text-base font-medium italic tracking-tight sm:text-lg">
        …now driven by excitement for what's next<span style="color: var(--accent)">!</span>
      </p>
    </section>

    <!-- EDUCATION -->
    <section id="education" class="py-12 md:py-16">
      <div class="reveal mb-12">
        <p class="eyebrow">Education</p>
        <h2 class="mt-3 font-[family-name:var(--font-display)] text-3xl font-semibold tracking-tight sm:text-5xl">Engineering meets analytics and business</h2>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {education.map((ed) => (
          <div class="card reveal p-6 sm:p-8">
            <p class="eyebrow text-[0.7rem]">{ed.period}</p>
            <h3 class="mt-3 font-[family-name:var(--font-display)] text-xl font-semibold">{ed.title}</h3>
            <p class="mt-1 text-sm" style="color: var(--muted)">{ed.org}</p>
            {ed.note && <p class="mt-4 text-sm" style="color: var(--accent)">{ed.note}</p>}
          </div>
        ))}
      </div>
    </section>

    <!-- PROJECTS -->
    <section id="projects" class="py-12 md:py-16">
      <div class="reveal mb-12">
        <p class="eyebrow">Projects & Entrepreneurship</p>
        <h2 class="mt-3 font-[family-name:var(--font-display)] text-3xl font-semibold tracking-tight sm:text-5xl">Building things that matter</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {projects.map((p) => (
          <article class="card reveal flex flex-col overflow-hidden">
            {p.image ? (
              p.link ? (
                <a href={p.link} target="_blank" rel="noopener" class="group block overflow-hidden" aria-label={`${p.linkLabel}: ${p.name}`}>
                  <img src={p.image} alt={`Preview of ${p.name}`} loading="lazy" class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
                </a>
              ) : (
                <div class="relative">
                  <img src={p.image} alt={`${p.name} – presentation at the International Symposium`} loading="lazy" class="aspect-[16/10] w-full object-cover" />
                  {'inset' in p && p.inset && (
                    <img src={p.inset} alt={`${p.name} measurement device`} loading="lazy" class="absolute right-4 bottom-4 aspect-square w-[32%] rounded-xl object-cover shadow-2xl" style="border: 2px solid var(--line)" />
                  )}
                </div>
              )
            ) : (
              <div class="placeholder grid aspect-[16/10] w-full place-items-center rounded-none border-0 text-sm">Photo: {p.name}</div>
            )}
            <div class="flex flex-1 flex-col p-6 sm:p-8">
              <p class="text-xs uppercase tracking-widest" style="color: var(--muted)">{p.kind}</p>
              <h3 class="mt-2 font-[family-name:var(--font-display)] text-2xl font-semibold">{p.name}</h3>
              <p class="mt-3 flex-1 leading-relaxed" style="color: var(--muted)">{p.text}</p>
              <div class="mt-5 flex flex-wrap gap-2">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
              {p.link && (
                <a href={p.link} target="_blank" rel="noopener" class="mt-6 inline-flex items-center gap-2 text-sm font-medium" style="color: var(--accent)">
                  {p.linkLabel} <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SKILLS -->
    <section id="skills" class="py-12 md:py-16">
      <div class="reveal mb-12">
        <p class="eyebrow">Skills</p>
        <h2 class="mt-3 font-[family-name:var(--font-display)] text-3xl font-semibold tracking-tight sm:text-5xl">Data meets business</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {Object.entries(skills).map(([group, items]) => (
          <div class="card reveal p-6 sm:p-8">
            <h3 class="font-[family-name:var(--font-display)] text-lg font-semibold">{group}</h3>
            <div class="mt-5 flex flex-wrap gap-2">{items.map((s) => <span class="tag">{s}</span>)}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- BEYOND WORK -->
    <section id="beyond" class="pt-12 md:pt-16 pb-8 md:pb-10">
      <div class="reveal mb-12">
        <p class="eyebrow">Beyond Work</p>
        <h2 class="mt-3 font-[family-name:var(--font-display)] text-3xl font-semibold tracking-tight sm:text-5xl">What keeps me going</h2>
        <p class="mt-4 max-w-2xl" style="color: var(--muted)">Endurance, team spirit and a love for the ocean – the same drive I bring to work.</p>
      </div>
      <article class="card reveal mb-4 grid items-center gap-5 overflow-hidden p-5 sm:p-6 md:grid-cols-[1fr_1.5fr]">
        <div>
          <p class="eyebrow text-[0.7rem]">Community</p>
          <h3 class="mt-2 font-[family-name:var(--font-display)] text-lg font-semibold">{surfClub.title}</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: var(--muted)">{surfClub.text}</p>
        </div>
        <!-- static photo strip: scroll sideways to see more -->
        <div class="psc-strip -mx-1 flex snap-x snap-mandatory gap-3 overflow-x-auto px-1 py-4 [scrollbar-width:thin]">
          {surfClub.gallery.map((g, i) => (
            <figure class="psc-photo shrink-0 snap-start" style={`--tilt:${[-2, 1.5, -1, 2, -1.5][i % 5]}deg`}>
              <img src={g.src} alt={g.alt} loading="lazy" class="h-36 w-28 rounded-xl object-cover sm:h-44 sm:w-32" />
            </figure>
          ))}
        </div>
      </article>

      <div class="mt-12">
        <HobbyOrbit />
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="pt-6 pb-12 md:pt-8 md:pb-16">
      <div class="card reveal relative isolate overflow-hidden p-8 text-center sm:p-16">
        <!-- data → decision animation -->
        <DataFlow class="absolute inset-0 -z-20" />
        <div aria-hidden="true" class="absolute inset-0 -z-10" style="background: radial-gradient(ellipse 45% 45% at 50% 45%, color-mix(in srgb, var(--bg) 60%, transparent), transparent 80%)"></div>
        <p class="eyebrow">Contact</p>
        <h2 class="mx-auto mt-3 max-w-2xl font-[family-name:var(--font-display)] text-3xl font-semibold tracking-tight sm:text-5xl">Let's turn data into decisions.</h2>
        <p class="mx-auto mt-4 max-w-xl" style="color: var(--muted)">Open for analytical roles, AI projects and conversations about GenAI and superintelligence.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          {profile.links.linkedin && (
            <a href={profile.links.linkedin} target="_blank" rel="noopener" class="rounded-full px-6 py-3 text-sm font-medium" style="background: var(--accent); color: var(--bg)">LinkedIn</a>
          )}
          <a href={profile.links.github} target="_blank" rel="noopener" class="rounded-full border px-6 py-3 text-sm font-medium transition hover:bg-white/5" style="border-color: var(--line)">GitHub</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="mx-auto max-w-6xl px-4 py-10 text-center text-xs sm:px-6" style="color: var(--muted)">
    © {new Date().getFullYear()} {profile.name} · Lisbon
  </footer>
</Layout>
